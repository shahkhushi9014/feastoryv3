# ---- copy to backend/.env and edit ----------------------------------

# MongoDB connection
#   Atlas (online, free M0 tier) — from Atlas: Connect → Drivers → copy the string:
# MONGO_URL=mongodb+srv://feastory_app:YOUR_PASSWORD@feastory.abc12.mongodb.net/?retryWrites=true&w=majority&appName=feastory
#   Local mongod:
# MONGO_URL=mongodb://localhost:27017
#   No MongoDB installed at all (in-memory emulator, data lost on restart — dev only):
MONGO_URL=mock://
MONGO_DB=feastory

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=720

# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# On AWS add your CloudFront / EC2 URL, e.g.
# CORS_ORIGINS=https://d1234abcd.cloudfront.net

# Dish images: "local" (saved to backend/uploads), "s3", or "blob" (Vercel Blob — automatic on Vercel)
STORAGE_BACKEND=local
PUBLIC_BASE_URL=http://localhost:8000
# S3_BUCKET=feastory-dish-images
# AWS_REGION=ap-south-1
# S3_PUBLIC_BASE_URL=https://d5678efgh.cloudfront.net   # optional CDN in front of the bucket

# Demo money every new student gets
STARTING_BALANCE=500

# First canteen-manager account (created if the canteen_staff collection is empty)
SEED_STAFF_EMP_ID=1234567890
SEED_STAFF_PIN=1234
SEED_STAFF_NAME=Canteen Manager
